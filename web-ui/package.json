{
  "name": "usagemesh-dashboard",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "format": "prettier --write src tests vite.config.ts vitest.config.ts",
    "format:check": "prettier --check src tests vite.config.ts vitest.config.ts"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "3.2.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@testing-library/react": "^16.3.0",
    "@types/node": "22.14.0",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.4.1",
    "fake-indexeddb": "^6.1.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tailwindcss": "4.1.12",
    "typescript": "5.8.3",
    "vite": "6.1.0",
    "vitest": "^3.2.4"
  }
}
